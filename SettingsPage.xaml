<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhFoodStreet.SettingsPage"
             Title="Cài đặt"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Section: Language -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="LanguageSectionLabel" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#E5E7EB" 
                        BackgroundColor="White" 
                        Padding="4">
                    <Picker x:Name="LanguagePicker"
                            HorizontalOptions="Fill"
                            TextColor="#1F2937">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Tiếng Việt</x:String>
                                <x:String>English</x:String>
                                <x:String>日本語</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Section: Access Pass -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="AccessPassSectionLabel" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#374151" />
                
                <Border StrokeShape="RoundRectangle 16" 
                        Stroke="Transparent" 
                        BackgroundColor="White" 
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.05"/>
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label x:Name="StatusIconLabel" Text="🔒" FontSize="24" VerticalOptions="Center"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="StatusTitleLabel" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#1F2937"/>
                                <Label x:Name="StatusDetailLabel" 
                                       FontSize="13" 
                                       TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
 
                        <BoxView HeightRequest="1" Color="#F3F4F6" HorizontalOptions="Fill"/>
 
                        <Label x:Name="UnlockDetailLabel"
                               FontSize="13"
                               TextColor="#4B5563"
                               LineBreakMode="WordWrap"/>

                        <Button x:Name="BuyButton"
                                Text="Mua Access Pass ($1/7 ngày)"
                                BackgroundColor="#FF7F50"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnBuyClicked"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Copyright -->
            <Label Text="© 2026 VinhKhanhFoodStreet. All rights reserved."
                   FontSize="12"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
