<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VinhKhanhFoodStreet.SettingsPage"
             Title="Cài đặt"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Section: Language -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="LanguageSectionLabel" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#374151" />
                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#E5E7EB" 
                        BackgroundColor="White" 
                        Padding="4">
                    <Picker x:Name="LanguagePicker"
                            HorizontalOptions="Fill"
                            TextColor="#1F2937">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Tiếng Việt</x:String>
                                <x:String>English</x:String>
                                <x:String>日本語</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Section: Access Pass -->
            <VerticalStackLayout Spacing="10">
                <Label x:Name="AccessPassSectionLabel" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#374151" />
                
                <Border StrokeShape="RoundRectangle 16" 
                        Stroke="Transparent" 
                        BackgroundColor="White" 
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.05"/>
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label x:Name="StatusIconLabel" Text="🔒" FontSize="24" VerticalOptions="Center"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="StatusTitleLabel" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#1F2937"/>
                                <Label x:Name="StatusDetailLabel" 
                                       FontSize="13" 
                                       TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
 
                        <BoxView HeightRequest="1" Color="#F3F4F6" HorizontalOptions="Fill"/>
 
                        <Label x:Name="UnlockDetailLabel"
                               FontSize="13"
                               TextColor="#4B5563"
                               LineBreakMode="WordWrap"/>

                        <Button x:Name="BuyButton"
                            Text="Mở khóa ngay" 
                            Clicked="OnBuyClicked"
                            BackgroundColor="#FF6B6B"
                            TextColor="White"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="45"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label x:Name="ShopOwnerSectionLabel" Text="Dành cho Chủ quán" 
                   FontSize="18" FontAttributes="Bold" Margin="5,15,5,5" TextColor="#333"/>
            <Frame HasShadow="False" BorderColor="#EEE" CornerRadius="15" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kinh doanh tại Vĩnh Khánh?" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Đăng ký tài khoản để tự quản lý thông tin gian hàng và xem báo cáo lượt khách." 
                           FontSize="12" TextColor="Gray"/>
                    <Button Text="Đăng ký kinh doanh" 
                            Clicked="OnRegisterShopClicked"
                            BackgroundColor="Transparent"
                            TextColor="#FF6B6B"
                            BorderColor="#FF6B6B"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="45"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Copyright -->
            <Label Text="© 2026 VinhKhanhFoodStreet. All rights reserved."
                   FontSize="12"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
