<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="VinhKhanhFoodStreet.QrScannerPage"
             Title="Quét QR"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="*,Auto">
        <Grid>
            <zxing:CameraBarcodeReaderView x:Name="CameraView"
                                           BarcodesDetected="OnBarcodesDetected" />

            <Grid Padding="20" RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0"
                        Padding="14"
                        BackgroundColor="#CC111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Quét QR kích hoạt nội dung"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="Hướng camera vào mã QR tại quầy hoặc điểm giới thiệu để nghe thuyết minh ngay."
                               FontSize="13"
                               TextColor="#E5E7EB" />
                    </VerticalStackLayout>
                </Border>

                <Grid Grid.Row="1"
                      Margin="24"
                      VerticalOptions="Center"
                      HorizontalOptions="Center"
                      WidthRequest="260"
                      HeightRequest="260">
                    <Border Stroke="#F97316"
                            StrokeThickness="3"
                            BackgroundColor="#10FFFFFF"
                            StrokeShape="RoundRectangle 28" />
                </Grid>

                <Border Grid.Row="2"
                        Padding="16"
                        BackgroundColor="#CC111827"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="StatusLabel"
                               Text="Đang chờ quét QR..."
                               FontSize="14"
                               TextColor="White" />

                        <Border x:Name="ResultCard"
                                IsVisible="False"
                                Padding="12"
                                BackgroundColor="#FFF7ED"
                                Stroke="#FDBA74"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="ResultNameLabel"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label x:Name="ResultDescriptionLabel"
                                       FontSize="13"
                                       TextColor="#374151"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <Button x:Name="ScanAgainButton"
                                    Text="Quét lại"
                                    Grid.Column="0"
                                    Clicked="OnScanAgainClicked"
                                    BackgroundColor="#F97316"
                                    TextColor="White"
                                    CornerRadius="16"
                                    HeightRequest="48" />
                            <Button x:Name="CloseButton"
                                    Text="Đóng"
                                    Grid.Column="1"
                                    Clicked="OnCloseClicked"
                                    BackgroundColor="#1F2937"
                                    TextColor="White"
                                    CornerRadius="16"
                                    HeightRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
