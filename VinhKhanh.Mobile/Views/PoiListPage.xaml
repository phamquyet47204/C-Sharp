<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VinhKhanh.Mobile.Models"
             xmlns:vm="clr-namespace:VinhKhanh.Mobile.ViewModels"
             x:Class="VinhKhanh.Mobile.Views.PoiListPage"
             Title="Khám phá Phố Vĩnh Khánh"
             BackgroundColor="#F9F9FB">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Search Bar Area -->
        <Border Grid.Row="0"
                Margin="16,16,16,8"
                StrokeShape="RoundRectangle 12"
                Stroke="Transparent"
                BackgroundColor="White"
                HeightRequest="56">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <SearchBar Placeholder="Tìm món ăn, quán ăn..."
                       Text="{Binding SearchText}"
                       FontSize="14"
                       TextColor="#1A1A1A"
                       CancelButtonColor="#FF6B35"
                       BackgroundColor="Transparent"/>
        </Border>

        <!-- POI List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredPois}"
                        SelectionMode="Single"
                        SelectionChanged="OnPoiSelected"
                        Margin="10,0">
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                    <Label Text="🔍" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Không tìm thấy địa điểm nào."
                           FontSize="16"
                           TextColor="#999"
                           HorizontalOptions="Center"
                           Margin="0,12"/>
                </StackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PoiRecord">
                    <Grid Padding="6">
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="Transparent"
                                BackgroundColor="White"
                                HeightRequest="100">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="100,*" Padding="8" ColumnSpacing="12">
                                
                                <!-- Thumb -->
                                <Image Grid.Column="0"
                                       Source="{Binding ImagePath}"
                                       Aspect="AspectFill"
                                       HeightRequest="84"
                                       WidthRequest="84">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="12" Rect="0,0,84,84"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Details -->
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1A1A1A"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding CategoryDisplayName}"
                                           FontSize="12"
                                           TextColor="#FF6B35"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="#666"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
